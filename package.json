{
  "name": "morphui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "legacy": "python3 -m http.server 4180 --directory legacy",
    "test:motion": "playwright test",
    "test:docs": "playwright test --config playwright.docs.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "turbo": "^2.11.3",
    "typescript": "^5.9.3"
  }
}
