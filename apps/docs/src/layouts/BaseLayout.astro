---
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { SITE } from '@/core/site';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Trail from the site root to this page, the root excluded. */
  breadcrumbs?: { name: string; path: string }[];
}

const { title, description = SITE.description, noindex = false, breadcrumbs = [] } = Astro.props;

/* `build.format: 'file'` means the pathname carries the emitted filename, so the
   canonical would read /docs/installation.html for a page served at
   /docs/installation — disagreeing with the sitemap, which already uses the
   short form. Normalise before building the URL. */
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = Astro.site ? new URL(canonicalPath, Astro.site).href : undefined;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const ogImage = Astro.site ? new URL(SITE.ogImage.path, Astro.site).href : undefined;

/*
 * `max-image-preview:large` is what lets a result carry a full-width thumbnail
 * rather than the default crop, and the uncapped snippet length stops a
 * description being trimmed that would otherwise be shown in full.
 */
const robots = noindex || !Astro.site
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1';

/*
 * One graph rather than a handful of loose entities: every node carries an `@id`
 * and points at the others, which is what says the person is the author of the
 * library and the library is what the page is about. Without the references a
 * search engine reads three unrelated things that happen to share a page.
 */
const person = `${SITE.repository}#person`;
const website = Astro.site ? `${new URL('/', Astro.site).href}#website` : undefined;
const library = `${SITE.npm}#library`;
const jsonLd = canonical && website && {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': person,
      name: SITE.author.name,
      alternateName: SITE.author.alternateName,
      url: SITE.author.url,
    },
    {
      '@type': 'WebSite',
      '@id': website,
      name: SITE.name,
      url: new URL('/', Astro.site).href,
      description: SITE.description,
      inLanguage: SITE.language,
      publisher: { '@id': person },
      about: { '@id': library },
    },
    {
      '@type': 'SoftwareSourceCode',
      '@id': library,
      name: SITE.package,
      description: SITE.description,
      version: SITE.version,
      codeRepository: SITE.repository,
      url: SITE.npm,
      license: SITE.license,
      programmingLanguage: ['TypeScript', 'JavaScript'],
      runtimePlatform: 'React',
      author: { '@id': person },
      maintainer: { '@id': person },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description,
      inLanguage: SITE.language,
      isPartOf: { '@id': website },
      about: { '@id': library },
      primaryImageOfPage: ogImage ? { '@type': 'ImageObject', url: ogImage } : undefined,
      ...(breadcrumbs.length > 0 && { breadcrumb: { '@id': `${canonical}#breadcrumb` } }),
    },
    ...(breadcrumbs.length > 0
      ? [{
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map((crumb, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: crumb.name,
            item: new URL(crumb.path, Astro.site).href,
          })),
        }]
      : []),
  ],
};
---
<!doctype html>
<html lang={SITE.language} data-morph-theme="ink" data-morph-mode="light">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link rel="preload" href="/fonts/schibsted-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/>
    <title>{pageTitle}</title><meta name="description" content={description}/>
    <meta name="author" content={SITE.author.name}/>
    <meta name="robots" content={robots}/>
    {canonical && <link rel="canonical" href={canonical}/>}

    {/* Both faces, so the browser chrome matches whichever the visitor is in. */}
    <meta name="theme-color" content="#F8F7F5" media="(prefers-color-scheme: light)"/>
    <meta name="theme-color" content="#101010" media="(prefers-color-scheme: dark)"/>

    <meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/>
    <meta property="og:type" content="website"/><meta property="og:site_name" content={SITE.name}/>
    <meta property="og:locale" content={SITE.locale}/>
    {canonical && <meta property="og:url" content={canonical}/>}
    {ogImage && <>
      <meta property="og:image" content={ogImage}/>
      <meta property="og:image:type" content={SITE.ogImage.type}/>
      <meta property="og:image:width" content={String(SITE.ogImage.width)}/>
      <meta property="og:image:height" content={String(SITE.ogImage.height)}/>
      <meta property="og:image:alt" content={`${SITE.name} — ${SITE.title.split('· ')[1]}`}/>
    </>}

    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/>
    {ogImage && <meta name="twitter:image" content={ogImage}/>}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml"/>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>}

    <script is:inline>
      (()=>{let mode='system';try{mode=localStorage.getItem('morphui-site-mode')||'system';}catch{}if(!['light','dark','system'].includes(mode))mode='system';document.documentElement.dataset.siteMode=mode;document.documentElement.dataset.morphMode=mode==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):mode;})();
      addEventListener('load',()=>requestAnimationFrame(()=>document.documentElement.dataset.scrollReady=''),{once:true});
    </script>
  </head>
  <body><a class="skip-link" href="#main">Skip to content</a><SiteHeader/><slot/><SiteFooter/></body>
</html>
