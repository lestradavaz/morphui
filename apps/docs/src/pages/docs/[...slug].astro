---
import { getCollection, render } from 'astro:content';
import DocsLayout from '@/layouts/DocsLayout.astro';
import Preview from '@/components/demos/Preview';
import ThemeGallery from '@/components/docs/ThemeGallery';
import InstallCommand from '@/components/docs/InstallCommand';
import CodeBlock from '@/components/ui/CodeBlock.astro';
import { release } from '@/core/data/catalog';
import { api } from '@/core/data/api';
import dialogSource from '@/components/demos/DialogDemo.tsx?raw';
import windowSource from '@/components/demos/WindowDemo.tsx?raw';
import cardSource from '@/components/demos/CardDemo.tsx?raw';
import buttonSource from '@/components/demos/ButtonDemo.tsx?raw';
import popoverSource from '@/components/demos/PopoverDemo.tsx?raw';
import tooltipSource from '@/components/demos/TooltipDemo.tsx?raw';
import contextMenuSource from '@/components/demos/ContextMenuDemo.tsx?raw';
import comboboxSource from '@/components/demos/ComboboxDemo.tsx?raw';
import multiSelectSource from '@/components/demos/MultiSelectDemo.tsx?raw';
import demoStyles from '@/components/demos/demo.css?raw';
export async function getStaticPaths() {
  return (await getCollection('docs')).map(entry=>({params:{slug:entry.id},props:{entry}}));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const kind = entry.data.kind;
const isComponent = kind !== 'guide';
/* The example under the preview is the demo that is on screen, not a rewrite of
   it: a code sample that has drifted from the thing it describes is worse than
   no sample at all. */
const sources: Record<string, string> = {
  dialog: dialogSource, window: windowSource, card: cardSource,
  button: buttonSource, popover: popoverSource, tooltip: tooltipSource,
  'context-menu': contextMenuSource, combobox: comboboxSource, 'multi-select': multiSelectSource,
};
const componentApi = api[kind] ?? { rows: [], note: '' };
const toc = [...(isComponent?[{slug:'preview',text:'Preview'},{slug:'example',text:'Example'}]:[]),...headings.filter(h=>h.depth===2),...(isComponent?[{slug:'api',text:'API reference'}]:[])];
---
<DocsLayout title={entry.data.title} description={entry.data.description} headings={toc}>
  {isComponent && <><section id="preview" class="doc-preview"><Preview kind={kind} client:load /></section><section id="example" class="example-section"><h2>Example</h2><p class="section-intro">The same component used in the preview. Works in JSX and TSX.</p><CodeBlock code={sources[kind]} lang="tsx" label={`${entry.data.title} example`}/><details class="styles-disclosure"><summary>Preview stylesheet <span>demo.css</span></summary><CodeBlock code={demoStyles} lang="css" label="demo.css"/></details></section></>}
  {entry.id === 'installation' && <div class="download-panel"><div><span class="release-tag">v{release.version}</span><p>Published on npm. Install it in your own project.</p></div><a class="button-primary" href={release.npm} rel="noreferrer">View on npm <span aria-hidden="true">↗</span></a><InstallCommand client:load/></div>}
  {entry.id === 'themes' && <ThemeGallery client:load/>}
  {entry.id === 'motion' && <Preview client:load/>}
  <div class="prose"><Content/></div>
  {isComponent && <section id="api" class="api-section"><h2>API reference</h2><p class="section-intro">{entry.data.title} props</p><div class="table-scroll" tabindex="0" aria-label="Component props"><table><thead><tr><th>Prop</th><th>Type / default</th><th>Description</th></tr></thead><tbody>{componentApi.rows.map(([name,type,value,description])=><tr><td><code>{name}</code></td><td><code>{type}</code><small>{value}</small></td><td>{description}</td></tr>)}</tbody></table></div><p class="api-note" set:html={componentApi.note}/></section>}
</DocsLayout>
<script>
  document.querySelectorAll('.prose pre').forEach(pre=>{
    const wrapper=document.createElement('div');wrapper.className='markdown-code';
    pre.parentNode?.insertBefore(wrapper,pre);wrapper.append(pre);
    const button=document.createElement('button');button.type='button';button.className='copy-button';button.textContent='Copy';button.setAttribute('aria-label','Copy code');
    wrapper.prepend(button);
    button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(pre.textContent??'');button.textContent='Copied';window.setTimeout(()=>button.textContent='Copy',1800);}catch{button.textContent='Select to copy';const range=document.createRange();range.selectNodeContents(pre);const selection=window.getSelection();selection?.removeAllRanges();selection?.addRange(range);}});
  });
</script>
