---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Component as EtherealShadow } from "@/components/ui/etheral-shadow";
import ComponentCarousel from "@/components/ui/ComponentCarousel.astro";
import "@/styles/home.css";
import Icon from "@/components/ui/Icon.astro";
import InstallCommand from "@/components/docs/InstallCommand";
import { release } from "@/core/data/catalog";
import { SITE } from "@/core/site";
---

<BaseLayout>
  <main id="main" class="home-main">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-background">
        <EtherealShadow client:load animation={{ scale: 90, speed: 80 }} />
      </div>
      <div class="hero-copy">
        <p class="intro-label">A small library of considered motion.</p>
        <h1 id="hero-heading">
          Interfaces that<br />stay <span>connected.</span>
        </h1>
        <p class="hero-description">
          Buttons become dialogs. Cards become stories.<br
            class="desktop-break"
          /> Nothing just appears. Everything comes from somewhere.
        </p>
        <div class="hero-actions">
          <a class="button-primary" href="/docs/installation"
            >Get started <Icon name="arrow" size={18} /></a
          >
          <a class="text-link" href="#components"
            >Explore components
            <!-- <Icon name="arrow" size={18} /> -->
          </a>
        </div>
        <div class="home-install" aria-label="Install MorphUI">
          <InstallCommand client:load compact />
        </div>
      </div>
    </section>
    <section
      class="collection"
      id="components"
      aria-labelledby="collection-heading"
    >
      <div class="section-heading">
        <div>
          <h2 id="collection-heading">Primitives that share a language.</h2><p>
            Small enough to understand. Flexible enough to make your own.
          </p>
        </div>
      </div>
      <ComponentCarousel />
    </section>
    <section class="theme-story">
      <div>
        <h2>Your palette.<br />The same feeling.</h2><p>
          Start with Ink. Find your color in seven presets, each with a light
          and dark counterpart. Or bring your own tokens.
        </p><a class="text-link" href="/docs/themes"
          >Explore themes <Icon name="arrow" size={18} /></a
        >
      </div><div class="theme-comparison">
        <div data-morph-theme="ink" data-morph-mode="light">
          <span>Ink, in the light</span><div class="theme-sample">
            <span>Make it yours</span><span aria-hidden="true">↗</span>
          </div>
        </div><div data-morph-theme="ink" data-morph-mode="dark">
          <span>Ink, after dark</span><div class="theme-sample">
            <span>Make it yours</span><span aria-hidden="true">↗</span>
          </div>
        </div>
      </div>
    </section>
    <section class="feedback-section" aria-labelledby="feedback-heading">
      <div>
        <p class="feedback-kicker">Early days, open ears</p><h2
          id="feedback-heading"
        >
          Help shape<br />what comes next.
        </h2>
      </div><div class="feedback-copy">
        <p>
          Morphui is new. Found a rough edge, need a component, or have an idea
          that would make motion feel better? Tell us. Your feedback helps guide
          what we build next.
        </p><div class="feedback-actions">
          <a
            class="button-primary"
            id="feedback-trigger"
            href={`${SITE.repository}/issues/new`}
            >Share feedback <Icon name="arrow" size={18} /></a
          >
          <!-- <a class="text-link" href={`${SITE.repository}/issues/new`}
            >Open a GitHub issue <Icon name="arrow" size={18} /></a
          > -->
          <a class="text-link" href={`${SITE.repository}/issues`}
            >See GitHub issues <Icon name="arrow" size={18} /></a
          >
        </div>
      </div>
    </section>
    <section class="start-section">
      <div>
        <h2>A little motion.<br />A lot of possibility.</h2><p>
          A growing set, seven themes, and the freedom to change every detail.
        </p>
      </div><div>
        <a class="button-primary" href="/docs/installation"
          >Get started <Icon name="arrow" size={18} /></a
        ><p class="release-note">Version {release.version}, on npm today.</p>
      </div>
    </section>
  </main>
</BaseLayout>
